# انسخ هذا الملف باسم .env وعدّل القيم

# رابط المنصة كما يفتحه المستخدمون (يُستخدم في روابط iCal)
APP_URL=https://mudeef.example.com

# مفتاح سري طويل لتشفير جلسات الدخول. ولّده بالأمر: openssl rand -base64 48
SESSION_SECRET=

# اجعلها true بعد تفعيل HTTPS
COOKIE_SECURE=true

# مكان ملف قاعدة البيانات
DATABASE_PATH=./data/mudeef.db

# كل كم دقيقة تتم مزامنة تقويمات المنصات (أقل قيمة 5)
SYNC_INTERVAL_MINUTES=15

# مفتاح اختياري لتشغيل المزامنة من الخارج: /api/cron/sync?key=...
CRON_SECRET=

PORT=3000
